{
  "name": "@knowalabs/meridian",
  "version": "0.2.0",
  "description": "Set up every AI coding tool, then run any coding agent under your project's rules and checks.",
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "claude",
    "copilot",
    "cursor",
    "mcp",
    "llm",
    "setup",
    "devtools"
  ],
  "author": "Sonal Sithara <sonalsithara2352@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/knowalabs/meridian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowalabs/meridian.git"
  },
  "bugs": {
    "url": "https://github.com/knowalabs/meridian/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "meridian": "dist/index.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pretest:e2e": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
